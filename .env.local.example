# Copy this file to .env.local and fill in real values.

# EmailJS (Contact form) — client-exposed, must keep the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_EMAILJS_SERVICE_CODE=
NEXT_PUBLIC_EMAILJS_TEMPLATE_CODE=
NEXT_PUBLIC_EMAILJS_USER_ID=

# NASA APOD API key (server-only — used by src/components/AstroPic/AstroPic.jsx).
# Get one at https://api.nasa.gov/
NASA_API_KEY=
